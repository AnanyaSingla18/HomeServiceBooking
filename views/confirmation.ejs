<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Booking Confirmed</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <%- include('navbar') %>
  <div class="container py-5">
    <div class="confirmation-container">
      <div class="confirmation-header">
        <div class="confirmation-icon">✅</div>
        <h2>Booking Confirmed!</h2>
        <p class="mb-0">Your service booking has been successfully created.</p>
      </div>
      <div class="confirmation-summary-card shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-start justify-content-between gap-3">
          <div>
            <div class="status-chip mb-2">Live provider tracking</div>
            <h3 class="summary-card-title">Your provider is 6 mins away</h3>
            <p class="text-muted mb-0">We’ve assigned an expert from a nearby location, and they are moving toward your service address.</p>
          </div>
          <div class="text-md-end">
            <span class="badge bg-success bg-opacity-15 text-success">On the way</span>
            <div class="tracking-value mt-3">2.4 km</div>
            <div class="text-muted">from your address</div>
          </div>
        </div>
      </div>
      <div class="confirmation-box">
        
        <!-- Booking Details Section -->
        <div class="confirmation-section">
          <h5 class="confirmation-section-title">📋 Booking Details</h5>
          <div class="confirmation-row">
            <span class="confirmation-label">Booking ID:</span>
            <span class="confirmation-value font-monospace" style="font-size: 0.9rem;"><%= booking._id || booking.id %></span>
          </div>
          <div class="confirmation-row">
            <span class="confirmation-label">Service:</span>
            <span class="confirmation-value"><%= booking.service ? booking.service.name : '—' %></span>
          </div>
          <div class="confirmation-row">
            <span class="confirmation-label">Customer Name:</span>
            <span class="confirmation-value"><%= booking.customerName %></span>
          </div>
          <div class="confirmation-row">
            <span class="confirmation-label">Date:</span>
            <span class="confirmation-value"><%= new Date(booking.date).toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
          </div>
          <div class="confirmation-row">
            <span class="confirmation-label">Time:</span>
            <span class="confirmation-value"><%= booking.timeSlot %></span>
          </div>
          <div class="confirmation-row">
            <span class="confirmation-label">Contact Method:</span>
            <span class="confirmation-value"><%= booking.contactMethod === 'email' ? '📧 Email' : '📱 Phone' %></span>
          </div>
          <div class="confirmation-row">
            <span class="confirmation-label">Contact Info:</span>
            <span class="confirmation-value"><%= booking.contactMethod === 'email' ? booking.email : booking.phone %></span>
          </div>
        </div>

        <!-- Provider Section -->
        <div class="confirmation-section">
          <h5 class="confirmation-section-title">👨‍🔧 Your Assigned Service Provider</h5>
          <% if (booking.providerName) { %>
            <div class="confirmation-row">
              <span class="confirmation-label">Provider Name:</span>
              <span class="confirmation-value"><strong><%= booking.providerName %></strong></span>
            </div>
            <div class="confirmation-row">
              <span class="confirmation-label">Specialization:</span>
              <span class="confirmation-value"><%= booking.providerNote %></span>
            </div>
            <div class="confirmation-row">
              <span class="confirmation-label">Contact:</span>
              <span class="confirmation-value">
                <a href="tel:<%= booking.providerPhone %>" class="btn btn-sm btn-outline-primary">
                  📞 <%= booking.providerPhone %>
                </a>
              </span>
            </div>
            <div class="confirmation-row">
              <span class="confirmation-label">Provider Status:</span>
              <span class="confirmation-value">Your service provider is on the way from a nearby location.</span>
            </div>
            <div class="confirmation-row">
              <span class="confirmation-label">Estimated arrival:</span>
              <span class="confirmation-value">Coming to your area soon. You’ll receive a call shortly.</span>
            </div>
            <div class="confirmation-row">
              <span class="confirmation-label">Live tracking:</span>
              <span class="confirmation-value">Tracking is active — provider is moving toward your address now.</span>
            </div>
            <div class="confirmation-row pt-0">
              <span></span>
              <span class="confirmation-value w-100 p-0">
                <div class="tracking-card p-3 rounded-4 border bg-light">
                  <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                      <div class="tracking-label mb-1"><strong>Provider is 6 mins away</strong></div>
                      <div class="text-muted">Current location: 2.4 km from your service address</div>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success">Live</span>
                  </div>
                  <div class="tracking-line d-flex align-items-center justify-content-between mb-2">
                    <span class="dot done"></span>
                    <span class="line flex-grow-1 mx-2"></span>
                    <span class="dot active"></span>
                    <span class="line flex-grow-1 mx-2"></span>
                    <span class="dot"></span>
                  </div>
                  <div class="d-flex justify-content-between small text-muted">
                    <span>Assigned</span>
                    <span>On the way</span>
                    <span>Near you</span>
                  </div>
                </div>
              </span>
            </div>
          <% } else if (booking.service && booking.service.providers && booking.service.providers.length) { %>
            <div class="confirmation-row">
              <span class="confirmation-label">Provider Name:</span>
              <span class="confirmation-value"><strong><%= booking.service.providers[0].name %></strong></span>
            </div>
            <div class="confirmation-row">
              <span class="confirmation-label">Specialization:</span>
              <span class="confirmation-value"><%= booking.service.providers[0].note %></span>
            </div>
            <div class="confirmation-row">
              <span class="confirmation-label">Contact:</span>
              <span class="confirmation-value">
                <a href="tel:<%= booking.service.providers[0].phone %>" class="btn btn-sm btn-outline-primary">
                  📞 <%= booking.service.providers[0].phone %>
                </a>
              </span>
            </div>
          <% } else { %>
            <div class="confirmation-row">
              <span class="confirmation-label">Status:</span>
              <span class="confirmation-value text-muted">A provider will be assigned to your booking shortly.</span>
            </div>
          <% } %>
        </div>

        <!-- Status Section -->
        <div class="confirmation-section">
          <h5 class="confirmation-section-title">📊 Status</h5>
          <div class="confirmation-row">
            <span class="confirmation-label">Booking Status:</span>
            <span>
              <span class="badge bg-<%= booking.status === 'approved' ? 'success' : booking.status === 'rejected' ? 'danger' : 'warning' %> px-3 py-2" style="font-size: 0.9rem;">
                <%= booking.status ? booking.status.charAt(0).toUpperCase() + booking.status.slice(1) : 'Pending' %>
              </span>
            </span>
          </div>
          <% if (booking.approvedBy) { %>
            <div class="confirmation-row">
              <span class="confirmation-label">Approved by:</span>
              <span class="confirmation-value"><%= booking.approvedBy.email || 'Admin' %></span>
            </div>
            <div class="confirmation-row">
              <span class="confirmation-label">Approved at:</span>
              <span class="confirmation-value"><%= booking.approvedAt ? new Date(booking.approvedAt).toLocaleString('en-IN') : '—' %></span>
            </div>
          <% } %>
        </div>

        <!-- Actions -->
        <div class="confirmation-actions">
          <a href="/" class="btn btn-primary btn-lg">
            🏠 Back to Home
          </a>
          <a href="/services" class="btn btn-outline-primary btn-lg">
            🔧 Book Another Service
          </a>
          <a href="/bookings" class="btn btn-outline-secondary btn-lg">
            📋 View All Bookings
          </a>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>