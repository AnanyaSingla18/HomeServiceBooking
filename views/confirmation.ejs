<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Booking Confirmed</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <%- include('navbar') %>
  <div class="container py-5">
    <div class="confirmation-container">
      <% const bookingStatus = booking.status || 'pending'; %>
      <% const bookingStatusLabel = bookingStatus.charAt(0).toUpperCase() + bookingStatus.slice(1); %>
      <% const bookingId = booking._id || booking.id; %>
      <% const isApproved = bookingStatus === 'approved'; %>
      <% const bookingAmount = booking.amount || (booking.service && booking.service.price) || 0; %>
      <% const isReviewable = bookingStatus === 'completed'; %>
      <div class="confirmation-header">
        <div class="confirmation-icon">✅</div>
        <div>
          <p class="confirmation-eyebrow mb-2">Service request received</p>
          <h1>Booking confirmed</h1>
          <p class="mb-0">Your request was submitted successfully. Your booking confirmation has been sent to your registered contact.</p>
        </div>
      </div>
      <div class="confirmation-summary-card shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-start justify-content-between gap-3">
          <div>
            <div class="status-chip mb-2">Booking status</div>
            <h3 class="summary-card-title">Your booking is <%= bookingStatus.toLowerCase() %></h3>
            <% if (bookingStatus === 'approved') { %>
              <p class="text-muted mb-0">Your booking has been approved. Please keep your phone available for coordination with the assigned provider.</p>
            <% } else if (bookingStatus === 'rejected') { %>
              <p class="text-muted mb-0">This booking was rejected. Please contact us or choose another service time.</p>
            <% } else { %>
              <p class="text-muted mb-0">Your booking is waiting for admin approval. We will share updates using your selected contact method.</p>
            <% } %>
          </div>
          <div class="text-md-end">
            <span class="badge bg-<%= bookingStatus === 'approved' ? 'success' : bookingStatus === 'rejected' ? 'danger' : bookingStatus === 'completed' ? 'primary' : 'warning' %>"><%= bookingStatusLabel %></span>
            <div class="tracking-value mt-3"><%= new Date(booking.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></div>
            <div class="text-muted"><%= booking.timeSlot %> appointment</div>
          </div>
        </div>
      </div>
      <div class="booking-progress mb-4" aria-label="Booking progress">
        <div class="progress-step is-complete">
          <span class="progress-marker">1</span>
          <span><strong>Request created</strong><small>Details saved</small></span>
        </div>
        <div class="progress-connector is-complete"></div>
        <div class="progress-step <%= booking.providerName ? 'is-complete' : '' %>">
          <span class="progress-marker">2</span>
          <span><strong>Provider assigned</strong><small><%= booking.providerName ? 'Contact available' : 'Pending assignment' %></small></span>
        </div>
        <div class="progress-connector <%= isApproved || isReviewable ? 'is-complete' : '' %>"></div>
        <div class="progress-step <%= isApproved || isReviewable ? 'is-complete' : bookingStatus === 'rejected' ? 'is-rejected' : '' %>">
          <span class="progress-marker">3</span>
          <span><strong>Service scheduled</strong><small><%= isReviewable ? 'Completed' : isApproved ? 'Approved' : bookingStatus === 'rejected' ? 'Rejected' : 'Awaiting approval' %></small></span>
        </div>
        <div class="progress-connector <%= isReviewable ? 'is-complete' : '' %>"></div>
        <div class="progress-step <%= isReviewable ? 'is-complete' : '' %>">
          <span class="progress-marker">4</span>
          <span><strong>Service completed</strong><small><%= isReviewable ? 'Completed' : 'Upcoming' %></small></span>
        </div>
      </div>
      <div class="confirmation-box">
        <div class="confirmation-reference">
          <div>
            <span class="confirmation-label">Booking reference</span>
            <strong id="bookingReference"><%= bookingId %></strong>
          </div>
          <button type="button" class="btn btn-sm btn-light border" id="copyBookingId" data-booking-id="<%= bookingId %>">Copy ID</button>
        </div>

        <!-- Booking Details Section -->
        <div class="confirmation-section">
          <h5 class="confirmation-section-title">📋 Booking Details</h5>
          <div class="confirmation-row">
            <span class="confirmation-label">Booking ID:</span>
            <span class="confirmation-value font-monospace" style="font-size: 0.9rem;"><%= bookingId %></span>
          </div>
          <div class="confirmation-row">
            <span class="confirmation-label">Service:</span>
            <span class="confirmation-value"><%= booking.service ? booking.service.name : '—' %></span>
          </div>
          <div class="confirmation-row">
            <span class="confirmation-label">Customer Name:</span>
            <span class="confirmation-value"><%= booking.customerName %></span>
          </div>
            <div class="confirmation-row">
              <span class="confirmation-label">Service Address:</span>
              <span class="confirmation-value"><%= booking.address || '—' %></span>
            </div>
          <div class="confirmation-row">
            <span class="confirmation-label">Date:</span>
            <span class="confirmation-value"><%= new Date(booking.date).toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
          </div>
          <div class="confirmation-row">
            <span class="confirmation-label">Time:</span>
            <span class="confirmation-value"><%= booking.timeSlot %></span>
          </div>
            <div class="confirmation-row">
              <span class="confirmation-label">Amount:</span>
              <span class="confirmation-value">₹<%= bookingAmount %></span>
            </div>
            <div class="confirmation-row">
              <span class="confirmation-label">Payment Method:</span>
              <span class="confirmation-value"><%= booking.paymentMethod === 'upi' ? 'Pay Using UPI' : 'Pay After Service' %></span>
            </div>
          <div class="confirmation-row">
            <span class="confirmation-label">Contact Method:</span>
            <span class="confirmation-value"><%= booking.contactMethod === 'email' ? '📧 Email' : '📱 Phone' %></span>
          </div>
          <div class="confirmation-row">
            <span class="confirmation-label">Contact Info:</span>
            <span class="confirmation-value"><%= booking.contactMethod === 'email' ? booking.email : booking.phone %></span>
          </div>
        </div>

        <!-- Provider Section -->
        <div class="confirmation-section">
          <h5 class="confirmation-section-title">👨‍🔧 Your Assigned Service Provider</h5>
          <% if (booking.providerName) { %>
            <div class="confirmation-row">
              <span class="confirmation-label">Provider Name:</span>
              <span class="confirmation-value"><strong><%= booking.providerName %></strong></span>
            </div>
            <div class="confirmation-row">
              <span class="confirmation-label">Specialization:</span>
              <span class="confirmation-value"><%= booking.providerNote %></span>
            </div>
            <div class="confirmation-row">
              <span class="confirmation-label">Contact:</span>
              <span class="confirmation-value">
                <a href="tel:<%= booking.providerPhone %>" class="btn btn-sm btn-outline-primary">
                  📞 <%= booking.providerPhone %>
                </a>
              </span>
            </div>
            <div class="confirmation-row">
              <span class="confirmation-label">Provider Status:</span>
              <span class="confirmation-value">Assigned for your scheduled appointment. Live location and arrival estimates are not available.</span>
            </div>
          <% } else if (booking.service && booking.service.providers && booking.service.providers.length) { %>
            <div class="confirmation-row">
              <span class="confirmation-label">Provider Name:</span>
              <span class="confirmation-value"><strong><%= booking.service.providers[0].name %></strong></span>
            </div>
            <div class="confirmation-row">
              <span class="confirmation-label">Specialization:</span>
              <span class="confirmation-value"><%= booking.service.providers[0].note %></span>
            </div>
            <div class="confirmation-row">
              <span class="confirmation-label">Contact:</span>
              <span class="confirmation-value">
                <a href="tel:<%= booking.service.providers[0].phone %>" class="btn btn-sm btn-outline-primary">
                  📞 <%= booking.service.providers[0].phone %>
                </a>
              </span>
            </div>
          <% } else { %>
            <div class="confirmation-row">
              <span class="confirmation-label">Status:</span>
              <span class="confirmation-value text-muted">A provider will be assigned to your booking shortly.</span>
            </div>
          <% } %>
        </div>

        <!-- Status Section -->
        <div class="confirmation-section">
          <h5 class="confirmation-section-title">📊 Status</h5>
          <div class="confirmation-row">
            <span class="confirmation-label">Booking Status:</span>
            <span>
              <span class="badge bg-<%= booking.status === 'approved' ? 'success' : booking.status === 'rejected' ? 'danger' : 'warning' %> px-3 py-2" style="font-size: 0.9rem;">
                <%= booking.status ? booking.status.charAt(0).toUpperCase() + booking.status.slice(1) : 'Pending' %>
              </span>
            </span>
          </div>
          <% if (booking.approvedBy) { %>
            <div class="confirmation-row">
              <span class="confirmation-label">Approved by:</span>
              <span class="confirmation-value"><%= booking.approvedBy.email || 'Admin' %></span>
            </div>
            <div class="confirmation-row">
              <span class="confirmation-label">Approved at:</span>
              <span class="confirmation-value"><%= booking.approvedAt ? new Date(booking.approvedAt).toLocaleString('en-IN') : '—' %></span>
            </div>
          <% } %>
        </div>

        <% if (isReviewable) { %>
          <div class="confirmation-section review-form-section">
            <h5 class="confirmation-section-title">Share your experience</h5>
            <p class="text-muted">Your review will be linked to this booking and shown publicly on our homepage.</p>
            <form id="reviewForm" class="review-form" action="/api/reviews" method="post">
              <input type="hidden" name="bookingId" value="<%= bookingId %>">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label" for="reviewCustomerName">Name</label>
                  <input class="form-control" id="reviewCustomerName" name="customerName" value="<%= booking.customerName %>" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="reviewContact">Booking contact</label>
                  <input class="form-control" id="reviewContact" name="contact" value="<%= booking.contactMethod === 'email' ? booking.email : booking.phone %>" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="reviewRating">Rating</label>
                  <select class="form-select" id="reviewRating" name="rating" required>
                    <option value="">Choose a rating</option>
                    <option value="5">5 - Excellent</option>
                    <option value="4">4 - Good</option>
                    <option value="3">3 - Average</option>
                    <option value="2">2 - Needs improvement</option>
                    <option value="1">1 - Poor</option>
                  </select>
                </div>
                <div class="col-12">
                  <label class="form-label" for="reviewComment">Review</label>
                  <textarea class="form-control" id="reviewComment" name="comment" rows="4" minlength="10" maxlength="500" placeholder="What was your experience like?" required></textarea>
                  <div class="form-text">10 to 500 characters.</div>
                </div>
              </div>
              <div class="d-flex align-items-center gap-3 mt-3">
                <button class="btn btn-primary" type="submit">Publish review</button>
                <span class="review-form-message" id="reviewFormMessage" role="status"></span>
              </div>
            </form>
          </div>
        <% } %>

        <!-- Actions -->
        <div class="confirmation-actions">
          <button type="button" class="btn btn-outline-secondary btn-lg" id="printConfirmation">
            Print confirmation
          </button>
          <a href="/" class="btn btn-primary btn-lg">
            🏠 Back to Home
          </a>
          <a href="/services" class="btn btn-outline-primary btn-lg">
            🔧 Book Another Service
          </a>
          <a href="/bookings" class="btn btn-outline-secondary btn-lg">
            📋 View All Bookings
          </a>
        </div>
      </div>
    </div>
  </div>
  <%- include('footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const copyButton = document.getElementById('copyBookingId');
      const printButton = document.getElementById('printConfirmation');
      const reviewForm = document.getElementById('reviewForm');
      const reviewMessage = document.getElementById('reviewFormMessage');

      if (copyButton) {
        copyButton.addEventListener('click', async function() {
          try {
            await navigator.clipboard.writeText(copyButton.dataset.bookingId);
            copyButton.textContent = 'Copied';
            window.setTimeout(() => { copyButton.textContent = 'Copy ID'; }, 1600);
          } catch (error) {
            copyButton.textContent = 'Copy unavailable';
          }
        });
      }

      if (printButton) {
        printButton.addEventListener('click', function() {
          window.print();
        });
      }

      if (reviewForm) {
        reviewForm.addEventListener('submit', async function(event) {
          event.preventDefault();
          const submitButton = reviewForm.querySelector('button[type="submit"]');
          submitButton.disabled = true;
          reviewMessage.textContent = 'Saving review...';
          try {
            const response = await fetch(reviewForm.action, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(Object.fromEntries(new FormData(reviewForm)))
            });
            const result = await response.json();
            if (!response.ok) throw new Error(result.error || 'Unable to save review.');
            reviewMessage.textContent = 'Thanks, your review is now published.';
            reviewForm.reset();
            submitButton.remove();
          } catch (error) {
            reviewMessage.textContent = error.message;
            submitButton.disabled = false;
          }
        });
      }
    });
  </script>
</body>
</html>