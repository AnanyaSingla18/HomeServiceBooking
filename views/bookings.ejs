<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bookings</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <%- include('navbar') %>
  <div class="container py-5">
    <div class="page-header mb-5">
      <h1 class="page-title">My Bookings</h1>
      <p class="page-subtitle">Track all your scheduled services and check booking status at a glance.</p>
    </div>
    <% if (bookings && bookings.length) { %>
      <div class="bookings-grid">
        <% bookings.forEach(b => { %>
          <% const bookingStatus = b.status || 'pending'; %>
          <% const bookingReference = String(b._id || b.id); %>
          <div class="booking-card">
            <div class="booking-header">
              <div>
                <span class="booking-kicker">Service appointment</span>
                <h5 class="booking-service"><%= b.service ? b.service.name : 'Service' %></h5>
              </div>
              <span class="booking-status booking-status-<%= bookingStatus %>"><%= bookingStatus.charAt(0).toUpperCase() + bookingStatus.slice(1) %></span>
            </div>
            <div class="booking-schedule">
              <div class="booking-date-icon">📅</div>
              <div>
                <span class="booking-detail-label">Scheduled for</span>
                <strong><%= new Date(b.date).toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) %></strong>
                <span class="booking-time"><%= b.timeSlot %> time slot</span>
              </div>
            </div>
            <div class="booking-notification booking-notification-<%= bookingStatus %>">
              <% if (bookingStatus === 'approved') { %>Your booking has been approved.<% } else if (bookingStatus === 'rejected') { %>Your booking needs attention. Please choose another service time.<% } else if (bookingStatus === 'completed') { %>Your service has been completed. We hope you enjoyed it.<% } else { %>Your booking is waiting for approval.<% } %>
            </div>
            <div class="booking-details">
              <p class="booking-row">
                <span>Customer</span><strong><%= b.customerName %></strong>
              </p>
              <p class="booking-row">
                <span>Contact</span><strong><%= b.contactMethod === 'email' ? b.email : b.phone %></strong>
              </p>
              <p class="booking-row">
                <span>Provider</span><strong><%= b.providerName || 'Awaiting assignment' %></strong>
              </p>
              <p class="booking-row">
                <span>Amount</span><strong>₹<%= b.amount || (b.service && b.service.price) || '—' %></strong>
              </p>
              <p class="booking-row">
                <span>Reference</span><strong class="booking-reference" title="<%= bookingReference %>"><%= bookingReference.length > 10 ? `...${bookingReference.slice(-8)}` : bookingReference %></strong>
              </p>
            </div>
            <a class="booking-details-link" href="/bookings/<%= b._id || b.id %>">View details</a>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-icon">📅</div>
        <h4>No bookings yet</h4>
        <p>Book your first home service and we'll take care of the rest.</p>
        <a href="/services" class="btn btn-primary mt-3">Browse Services</a>
      </div>
    <% } %>
  </div>
  <%- include('footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
