<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Admin Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body class="admin-login-page">
  <%- include('navbar') %>
  <main class="auth-page">
    <div class="container py-5">
      <div class="row justify-content-center align-items-center min-vh-75">
        <div class="col-lg-6">
          <div class="auth-intro text-center mb-4">
            <span class="eyebrow-chip">Admin access</span>
            <h1 class="auth-title">Secure admin login</h1>
            <p class="auth-subtitle">Enter your credentials to manage bookings, approve services, and monitor customer requests.</p>
          </div>
          <div class="login-card">
            <div class="login-header">
              <div class="login-icon">🔐</div>
              <div>
                <h3>Welcome back</h3>
                <p>Sign in to your admin dashboard</p>
              </div>
            </div>
            <div class="login-body">
              <% if (error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                  <strong>Error:</strong> <%= error %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
              <% } %>
              <form method="POST" action="/admin/login">
                <div class="form-group mb-4">
                  <label for="email" class="form-label">Email Address</label>
                  <input type="email" id="email" name="email" class="form-control form-control-lg" placeholder="admin@example.com" required />
                </div>
                <div class="form-group mb-4">
                  <label for="password" class="form-label">Password</label>
                  <input type="password" id="password" name="password" class="form-control form-control-lg" placeholder="Enter your password" required />
                </div>
                <button type="submit" class="btn btn-primary w-100 btn-lg fw-bold">Login</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>